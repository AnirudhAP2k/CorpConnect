# ── n8n Automation ──────────────────────────────────────────────────────────
N8N_SHARED_SECRET=          # Next.js → n8n HMAC signing (outbound webhooks)
N8N_CALLBACK_SECRET=        # n8n → /api/webhooks/n8n-callback (inbound callbacks)
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=changeme
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Org verification webhook secret (shared with AI service for POST /api/webhooks/org-verification)
